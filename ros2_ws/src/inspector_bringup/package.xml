<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>

<!--bringup is ROS convention for system starting package containing the launch files, world files, map and parameter YAML -->
<package format="3">
  <name>inspector_bringup</name>
  <version>0.0.0</version>
  <description>Launch files, parameters, warehouse world and saved maps for warehouse inspector</description>
  <maintainer email="Donafuwa@outlook.com">David Onafuwa</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Launch system -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <!-- Gazebo Harmonic and the ROS -> Gazebo bridges -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <!-- TurtleBot3 Waffle model and bridge config for Harmonic -->
  <exec_depend>nav2_minimal_tb3_sim</exec_depend>

  <!-- Visualisation and driving in terminal -->
  <exec_depend>rviz2</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <!-- Mapping -->
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
